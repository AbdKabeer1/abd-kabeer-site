---
import "@fontsource-variable/syne/index.css";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://abd-kabeer-site.vercel.app");
const ogImage = new URL("/og.png", Astro.site ?? "https://abd-kabeer-site.vercel.app").toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: "Product & Operations",
  email: profile.email,
  telephone: profile.phone,
  address: { "@type": "PostalAddress", addressLocality: "Lahti", addressCountry: "FI" },
  alumniOf: "LAB University of Applied Sciences",
  sameAs: [profile.github],
  url: canonical.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#05070b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Abd Kabeer Salako — product and operations portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="spotlight" id="spotlight" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="monogram" href="/" aria-label={`${profile.name} — home`}>AK</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/#about">About</a>
          <a href="/#experience">Experience</a>
          <a href="/#projects">Projects</a>
          <a href="/#skills">Skills</a>
          <a href="/#contact">Contact</a>
          <a class="nav-cv" href="/cv">CV ↗</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {profile.name} — interface 2045</span>
        <span class="footer-links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href="/cv">CV</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // scroll reveals
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("in"));
      }

      // spotlight follows the pointer (fine pointers only)
      const spot = document.getElementById("spotlight");
      if (spot && window.matchMedia("(pointer: fine)").matches) {
        window.addEventListener(
          "pointermove",
          (e) => {
            spot.style.setProperty("--mx", e.clientX + "px");
            spot.style.setProperty("--my", e.clientY + "px");
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
