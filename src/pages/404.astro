---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Abd Kabeer Salako" description="That page does not exist." noindex>
  <section class="section container">
    <p class="eyebrow">404</p>
    <h1 style="font-family: var(--serif); font-weight: 500; font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -.03em; margin: 0 0 16px;">
      This page took a different route.
    </h1>
    <p style="color: var(--muted); margin-bottom: 24px;">Let’s get you back to something useful.</p>
    <a class="btn" href="/">Back home</a>
  </section>
</Base>
