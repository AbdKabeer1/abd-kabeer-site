---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { profile } from "../data/profile";
import mymemoShot from "../assets/previews/mymemo.png";
import naijaShot from "../assets/previews/naija-penalty.png";
import sniperShot from "../assets/previews/suomi-sniper.png";
import smeShot from "../assets/previews/sme-inventory.svg";

const previews: Record<string, ImageMetadata> = {
  "MyMemo": mymemoShot,
  "Naija Penalty": naijaShot,
  "Suomi Sniper": sniperShot,
  "SME Inventory Tracker": smeShot,
};

const marquee = [
  "Product thinking",
  "Supply chain",
  "E-commerce ops",
  "PRD writing",
  "Feature prioritisation",
  "Warehouse logistics",
  "Stakeholder coordination",
  "Three.js games",
];
---

<Base
  title={`${profile.name} — Product & Operations`}
  description="Portfolio of Abd Kabeer Salako — product management, operations and logistics. International Business student in Lahti, Finland."
>
  <section class="hero container">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">// Portfolio 2045 · Product / Operations</p>
        <h1 class="hero-title">
          <span class="line"><span>Abd Kabeer</span></span>
          <span class="line"><span class="outline">Salako</span></span>
        </h1>
        <p class="hero-lede">
          Product systems for a world that moves faster than its processes.
          I turn operational mess into <strong>structured products</strong> — stockrooms,
          suppliers, PRDs, priorities.
        </p>
        <div class="hero-actions">
          <a class="btn" href={`mailto:${profile.email}`}>Open a channel</a>
          <a class="btn ghost" href="/cv">View CV</a>
        </div>
        <p class="coords">Lahti, Finland · 60.98°N 25.66°E · UTC+3 · Available for internships</p>
      </div>

      <aside class="hero-panel reveal">
        <div class="panel-scan" aria-hidden="true"></div>
        <div class="panel-top">
          <span>System // profile</span>
          <span class="status-dot">open</span>
        </div>
        <div class="panel-row">
          <span class="panel-label">Role</span>
          <span class="panel-value">Product &amp; operations</span>
        </div>
        <div class="panel-row">
          <span class="panel-label">Studying</span>
          <span class="panel-value">BBA International Business, LAB</span>
        </div>
        <div class="panel-row">
          <span class="panel-label">Focus</span>
          <span class="panel-value">Logistics · e-commerce · SaaS</span>
        </div>
        <div class="panel-row">
          <span class="panel-label">Certified</span>
          <span class="panel-value">HNG PM · Google PM</span>
        </div>
        <div class="panel-row">
          <span class="panel-label">Languages</span>
          <span class="panel-value">EN fluent · FI basic · YO native</span>
        </div>
      </aside>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...marquee, ...marquee].map((item) => <span class="marquee-item">{item}</span>)}
      </div>
    </div>
  </section>

  <section class="metrics container reveal" aria-label="Selected numbers">
    <div class="metric">
      <div class="metric-value" data-count="30" data-suffix="+">30+</div>
      <div class="metric-label">device sales managed weekly</div>
    </div>
    <div class="metric">
      <div class="metric-value" data-count="100" data-suffix="+">100+</div>
      <div class="metric-label">warehouse items per shift</div>
    </div>
    <div class="metric">
      <div class="metric-value" data-count="6" data-suffix="-flat">6-flat</div>
      <div class="metric-label">residential project coordinated</div>
    </div>
    <div class="metric">
      <div class="metric-value" data-count="4" data-suffix="">4</div>
      <div class="metric-label">apartment turnovers daily</div>
    </div>
  </section>

  <section class="section container reveal" id="about">
    <div class="section-head">
      <p class="eyebrow">// About</p>
      <h2 class="section-title">Operational instincts. <em>Product discipline.</em></h2>
    </div>
    <div class="about-grid">
      <div class="about-copy">
        <p>{profile.summary}</p>
        <p>
          I care about the unglamorous parts: a clean requirements document, a supplier
          who answers on time, a stock list that tells the truth. My goal is to bring that
          grounded perspective into a product team.
        </p>
      </div>
      <div class="terminal" aria-label="Quick profile">
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="term-line"><span class="term-key">role</span><span class="term-val">product &amp; operations</span></div>
        <div class="term-line"><span class="term-key">base</span><span class="term-val">lahti, finland</span></div>
        <div class="term-line"><span class="term-key">studying</span><span class="term-val">international business</span></div>
        <div class="term-line"><span class="term-key">certified</span><span class="term-val">hng pm · google pm</span></div>
        <div class="term-line"><span class="term-key">status</span><span class="term-val hl">open to internships</span></div>
      </div>
    </div>
  </section>

  <section class="section container reveal" id="experience">
    <div class="section-head">
      <p class="eyebrow">// Experience log</p>
      <h2 class="section-title">Where the operational instincts come from.</h2>
    </div>
    <div class="log">
      {profile.experience.map((job) => (
        <article class="log-item">
          <div>
            <div class="log-when">{job.period}</div>
            <div class="log-where">{job.location}</div>
          </div>
          <div>
            <h3 class="log-role">{job.role}</h3>
            <p class="log-company">{job.company}</p>
            <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container reveal" id="projects">
    <div class="section-head">
      <p class="eyebrow">// Deployed work</p>
      <h2 class="section-title">Products, games, and <em>shipped things.</em></h2>
    </div>
    <div class="projects">
      {profile.projects.map((project) => (
        <article class="project">
          {previews[project.name] && (
            <div class="project-media">
              <Image
                src={previews[project.name]}
                alt={`${project.name} — preview`}
                widths={[640, 1280]}
                sizes="(max-width: 980px) 92vw, 46vw"
                format="webp"
                loading="lazy"
              />
            </div>
          )}
          <div class="project-top">
            <span class={`tag ${project.kind === "game" ? "game" : ""}`}>{project.tag}</span>
            <span class="period">{project.period}</span>
          </div>
          <h3>{project.name}</h3>
          <p class="project-desc">{project.summary}</p>
          <ul>{project.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
          {project.links && (
            <div class="project-links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section container reveal" id="skills">
    <div class="section-head">
      <p class="eyebrow">// Capabilities</p>
      <h2 class="section-title">The stack I work with.</h2>
    </div>
    <div class="skills-grid">
      {profile.skills.map((group) => (
        <div>
          <p class="skill-label">{group.label}</p>
          <div class="chips">
            {group.items.map((item) => <span class="chip">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
    <div class="languages">
      {profile.languages.map((lang) => (
        <span class="lang"><b>{lang.name}</b> — {lang.level}</span>
      ))}
    </div>
  </section>

  <section class="section container reveal" id="education">
    <div class="section-head">
      <p class="eyebrow">// Education</p>
      <h2 class="section-title">The formal side of the craft.</h2>
    </div>
    <div class="duo">
      <div>
        <p class="duo-title">Education</p>
        {profile.education.map((edu) => (
          <div class="entry">
            <h4>{edu.qualification}</h4>
            <div class="issuer">{edu.institution}{edu.location ? ` · ${edu.location}` : ""}</div>
            {edu.period && <div class="when">{edu.period}</div>}
            {edu.detail && <p class="detail">{edu.detail}</p>}
          </div>
        ))}
      </div>
      <div>
        <p class="duo-title">Certifications</p>
        {profile.certifications.map((cert) => (
          <div class="entry">
            <h4>{cert.name}</h4>
            <div class="issuer">{cert.issuer} · {cert.period}</div>
            <p class="detail">{cert.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container" id="contact">
    <div class="contact-band reveal">
      <div>
        <p class="eyebrow">// Contact</p>
        <h2>Let’s build<br /><em>what’s next.</em></h2>
        <p>
          Looking for an intern who already understands stockrooms, suppliers and customers?
          I’d like to hear about the team.
        </p>
      </div>
      <div class="contact-actions">
        <a class="btn" href={`mailto:${profile.email}`}>Open a channel</a>
        <a class="btn ghost" href={profile.phoneHref}>{profile.phone}</a>
        <a class="btn ghost" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </div>
  </section>

  <script is:inline>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // animated metric counters
    const counters = document.querySelectorAll(".metric-value[data-count]");
    const runCounter = (el) => {
      const target = Number(el.dataset.count || 0);
      const suffix = el.dataset.suffix || "";
      if (reduceMotion) { el.textContent = target + suffix; return; }
      const start = performance.now();
      const duration = 1100;
      const tick = (now) => {
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    if ("IntersectionObserver" in window && !reduceMotion) {
      const cio = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) { runCounter(entry.target); cio.unobserve(entry.target); }
        }
      }, { threshold: 0.4 });
      counters.forEach((el) => cio.observe(el));
    } else {
      counters.forEach(runCounter);
    }

    // card tilt + local glow (fine pointers only)
    if (window.matchMedia("(pointer: fine)").matches && !reduceMotion) {
      document.querySelectorAll(".project").forEach((card) => {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.setProperty("--px", (px * 100).toFixed(1) + "%");
          card.style.setProperty("--py", (py * 100).toFixed(1) + "%");
          card.style.transform =
            `perspective(900px) rotateX(${((0.5 - py) * 3.5).toFixed(2)}deg) ` +
            `rotateY(${((px - 0.5) * 3.5).toFixed(2)}deg) translateY(-2px)`;
        });
        card.addEventListener("pointerleave", () => { card.style.transform = ""; });
      });
    }
  </script>
</Base>
